---
import Layout from '../layouts/Layout.astro';
import LabSchema from '../components/LabSchema.astro';

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Alexandre Bahar',
  url: 'https://alexandrebahar.com',
  jobTitle: 'Étudiant BTS SIO option SISR',
  sameAs: [],
};
---

<Layout
  title="Accueil"
  description="Portfolio professionnel d'Alexandre Bahar, étudiant en BTS SIO option SISR."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
  </Fragment>

  <section class="hero">
    <h1>Alexandre Bahar</h1>
    <p>Étudiant en 2<sup>e</sup> année de BTS SIO, option SISR (session 2027).</p>
    <p class="hero__objectif">
      Objectif : à compléter.
    </p>
  </section>

  <section>
    <h2>Schéma du lab</h2>
    <p>Chaque élément renvoie vers la fiche de réalisation correspondante.</p>
    <LabSchema />
  </section>
</Layout>
